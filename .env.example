# Database Framework Environment Variables
# Copy this file to .env and update with your actual credentials

# ===== ORACLE DATABASE =====
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_USER=system
ORACLE_PASSWORD=oracle_password_here
ORACLE_SID=ORCLDB

# Oracle Pool Configuration (Optional)
ORACLE_POOL_MAX=10
ORACLE_POOL_MIN=2
ORACLE_IDLE_TIMEOUT=30000
ORACLE_CONNECTION_TIMEOUT=5000
ORACLE_MAX_USES=100

# ===== POSTGRESQL DATABASE =====
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres_password_here
PG_DB=testdb

# PostgreSQL Pool Configuration (Optional)
PG_POOL_MAX=10
PG_POOL_MIN=2
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=5000
PG_STATEMENT_TIMEOUT=30000

# ===== MYSQL DATABASE (Future) =====
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=mysql_password_here
# MYSQL_DB=testdb

# ===== LOGGING =====
# Set to 'true' to enable verbose database logging
DB_LOG_VERBOSE=false

# ===== ENVIRONMENT =====
NODE_ENV=test
CI=false
BASE_URL=http://localhost:3000

# ===== PLAYWRIGHT =====
PWDEBUG=false
HEADLESS=true
